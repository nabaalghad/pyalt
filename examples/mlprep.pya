# mlprep — ML text preprocessing as a compiled module for Python pipelines.
# The classic GPU-starving step: corpus -> vocabulary -> integer token ids.
#
#   python pyalt.py buildpy examples/mlprep.pya
#   >>> import mlprep
#   >>> vocab = mlprep.build_vocab(lines, 2)
#   >>> ids = mlprep.encode(lines, vocab)

def build_vocab(lines: list[str], min_count: int) -> dict[str, int]:
    counts: dict[str, int] = {}
    for line in lines:
        for raw in line.lower().split(" "):
            w = raw.strip()
            if len(w) > 0:
                if w in counts:
                    counts[w] = counts[w] + 1
                else:
                    counts[w] = 1
    vocab: dict[str, int] = {}
    idx = 0
    for w in counts:
        if counts[w] >= min_count:
            vocab[w] = idx
            idx = idx + 1
    return vocab

def encode(lines: list[str], vocab: dict[str, int]) -> list[int]:
    ids: list[int] = []
    for line in lines:
        for raw in line.lower().split(" "):
            w = raw.strip()
            if len(w) > 0:
                ids.append(vocab.get(w, -1))
    return ids
