# Parallel benchmark: per-line tokenization across all cores.
# Serial twin: ser_wordcount.pya / ser_wordcount.py (identical logic, ordinary for).

t0 = clock()
lines = read_lines("data/bench_wordfreq.txt")
n = len(lines)
counts: list[int] = []
for i in range(n):
    counts.append(0)

parallel for j in range(n):
    c = 0
    for raw in lines[j].lower().split(" "):
        word = raw.strip()
        if len(word) > 4:
            c = c + 1
    counts[j] = c

total = 0
for j in range(n):
    total = total + counts[j]
t1 = clock()

print(f"lines={n} long_words={total}")
print(f"elapsed: {t1 - t0} seconds")
