# Benchmark 3: mandelbrot — pure numeric loops (SPEC §7 #3)
# Identical logic to mandelbrot.py.

def mandel(cr: float, ci: float, max_iter: int) -> int:
    zr = 0.0
    zi = 0.0
    i = 0
    while i < max_iter:
        if zr * zr + zi * zi > 4.0:
            return i
        new_zr = zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = new_zr
        i = i + 1
    return max_iter

t0 = clock()
width = 1200
height = 800
total = 0
for py in range(height):
    for px in range(width):
        cr = -2.0 + 3.0 * float(px) / float(width)
        ci = -1.2 + 2.4 * float(py) / float(height)
        total = total + mandel(cr, ci, 100)
t1 = clock()

print(f"total={total}")
print(f"elapsed: {t1 - t0} seconds")
